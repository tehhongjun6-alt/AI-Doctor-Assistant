PORT=8002
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEOAPIFY_API_KEY=replace_with_your_geoapify_key
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
MEDICAL_API_TIMEOUT_MS=8000
MEDLINEPLUS_TOOL=consultation-assistant
MEDLINEPLUS_EMAIL=
NHS_CONTENT_API_SEARCH_URL=
NHS_API_KEY=
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=
WHO_ICD_RELEASE=2026-01
# Supabase PostgreSQL（Connect → Session pooler 的连接字符串）
DATABASE_URL=
# 至少 32 个字符的随机字符串
JWT_SECRET=
# 登录有效期（秒），默认 86400 = 24 小时
JWT_TTL_SECONDS=86400
# 每位用户每分钟最多 AI 问诊次数（保护 Gemini 配额），默认 12
CHAT_RATE_LIMIT_PER_MINUTE=12
# 路由（分流判断）超时毫秒数与最多尝试次数；超时直接使用规则判断
GEMINI_ROUTER_TIMEOUT_MS=5000
GEMINI_ROUTER_MAX_ATTEMPTS=2
# 生成回答遇到忙碌（429/503）时最多尝试的模型数
GEMINI_MAX_ATTEMPTS=2
# 规则优先路由：明确的寒暄/症状/知识提问跳过模型分流（false 关闭）
ROUTER_RULE_FIRST=true
